{
  "name": "starmemory-dsh",
  "version": "1.2.17",
  "type": "module",
  "description": "StarMemory 分层记忆 DSH 版：长期记忆 + 碎片记忆 + SQLite 归档，Agent 主动调用工具召回；v1.2.17 起含主设置页独立面板与聊天输入框右下角召回触发器（composer 子槽 conversation.input.right，星空流星雨主题滑块，弹窗定位用 useAnchoredPosition）",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.mjs",
    "lib",
    "client",
    "icon.svg",
    "locale",
    "manual.json",
    "cordis.patch.yml"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "scripts": {
    "check:client": "node scripts/check-client.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test": "node --test test/*.test.js test/*.test.mjs",
    "gate:node": "npx --no-install esbuild index.mjs --bundle --platform=node --format=esm --outfile=NUL --external:@deepseek-ai/*",
    "gate:schema": "node scripts/check-schema.mjs",
    "gate": "npm run gate:node && npm run gate:schema && npm run check:client && npm run check:i18n && npm run check:package && npm test"
  },
  "license": "MIT",
  "private": false
}
